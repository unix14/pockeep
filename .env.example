# PocKeep configuration. Copy to .env and edit:
#
#   cp .env.example .env
#
# Every value below is optional: the defaults shown are what PocKeep uses when
# the variable is absent. Values still left as "replace_me..." are treated as
# unset, so a placeholder can never silently become a real password.

# ---------------------------------------------------------------------------
# Initial accounts (created only on first start, when the database has no users)
# ---------------------------------------------------------------------------

# The admin account.
ADMIN_USERNAME=admin
# Leave as the placeholder to have a random one-time password generated and
# printed once in the container log, which must then be changed at first
# sign-in. If you set a real password here it is used as-is and is NOT forced
# to change, so pick a strong one (minimum 8 characters).
ADMIN_PASSWORD=replace_me_with_a_strong_admin_password

# A second, non-admin account. Set SEED_USER= (empty) to skip creating it.
SEED_USER=user
# Always temporary: whether generated or set here, it must be changed at first
# sign-in (minimum 6 characters).
SEED_USER_PASSWORD=replace_me_with_a_temp_user_password

# Public sign-up. Keep false for a private instance; the admin creates accounts.
ALLOW_REGISTRATION=false

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------

# Address and port the Node process listens on inside the container.
HOST=0.0.0.0
PORT=3000

# Docker Compose port publishing (host side).
#   0.0.0.0    reachable from your whole LAN
#   127.0.0.1  localhost only (use with a reverse proxy or `tailscale serve`)
#   100.x.y.z  your LXC's Tailscale IP: reachable only on the tailnet
POCKEEP_BIND=0.0.0.0
POCKEEP_PORT=3000

# ---------------------------------------------------------------------------
# Sessions and cookies
# ---------------------------------------------------------------------------

# How long a sign-in lasts, in days. Renews itself once half the time is left.
SESSION_DAYS=30

# Marks the session cookie Secure. "auto" does it whenever the request arrived
# over HTTPS; set true when you terminate HTTPS in front of PocKeep.
COOKIE_SECURE=auto

# Trust X-Forwarded-* headers. Enable ONLY behind a proxy you control
# (Tailscale serve, Caddy, nginx), never when the port is exposed directly.
TRUST_PROXY=false

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------

# Where the SQLite database and stored export files live. In Docker this is the
# /data volume, mapped to ./data on the host.
DATA_DIR=/data
# Override individual paths only if you need them outside DATA_DIR.
# DB_FILE=/data/pockeep.db
# EXPORTS_DIR=/data/exports

# Keep a copy of every uploaded WhatsApp export under EXPORTS_DIR/<userId>/.
STORE_EXPORTS=true

# Upload size ceilings, in megabytes.
MAX_IMPORT_MB=25
MAX_BACKUP_MB=100

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------

NODE_ENV=production
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Path to the built frontend. The Docker image sets this correctly already.
# WEB_DIST=/app/web/dist

# ---------------------------------------------------------------------------
# Tailscale sidecar (only for docker-compose.tailscale.yml)
# ---------------------------------------------------------------------------

# Auth key from the Tailscale admin console (Settings -> Keys). Required when
# you bring up the tailscale override file.
# TS_AUTHKEY=tskey-auth-replace_me
# MagicDNS hostname the instance gets on your tailnet.
TS_HOSTNAME=pockeep
# Extra flags for `tailscale up`, e.g. --advertise-tags=tag:pockeep
TS_EXTRA_ARGS=

# ---------------------------------------------------------------------------
# Command-line user management (server/src/cli.js)
# ---------------------------------------------------------------------------

# Only read by `npm --prefix server run user`; it prompts when unset. Pass it
# per command (SM_PASSWORD=... npm run user ...) rather than storing it here.
# SM_PASSWORD=
